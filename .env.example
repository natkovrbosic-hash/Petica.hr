# --- Supabase (lokalno: `npx supabase status` ispisuje URL i ključeve) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Servisni ključ: SAMO na serveru (webhook, brisanje računa, emailovi). Nikad s prefiksom NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 1 = preglednik pristupa Supabaseu preko /sb na adresi aplikacije (kad baza nije izravno dostupna, npr. pregled)
NEXT_PUBLIC_SUPABASE_PROXY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=podrska@instrukcije24.hr

# --- Istaknuti profil ---
# Cijena u €/mj (5–9). Koristi se za prikaz i u Stripe Checkoutu ako STRIPE_PRICE_ID nije zadan.
NEXT_PUBLIC_FEATURED_PRICE_EUR=7
# Feature flag: „prva 3 mjeseca od lansiranja sve besplatno”
NEXT_PUBLIC_LAUNCH_PROMO=true
NEXT_PUBLIC_LAUNCH_DATE=2026-12-01
NEXT_PUBLIC_LAUNCH_PROMO_MONTHS=3

# --- Stripe (bez ključa pretplata radi u testnom/simuliranom načinu) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Neobavezno: postojeća mjesečna cijena iz Stripe Dashboarda (price_...). Bez nje se koristi NEXT_PUBLIC_FEATURED_PRICE_EUR.
STRIPE_PRICE_ID=

# --- Email (Resend). Bez ključa se emailovi ispisuju u konzolu. ---
RESEND_API_KEY=
EMAIL_FROM=Instrukcije24.hr <obavijesti@instrukcije24.hr>

# --- Podaci o vlasniku (pravne stranice) ---
COMPANY_NAME=
COMPANY_OIB=
COMPANY_ADDRESS=
